@model IEnumerable<Concepcion_Midterm_Store.Models.CartItem>

@{
    ViewData["Title"] = "Cart";
}

<div class="container mt-4">

    <h1 class="mb-4">Shopping Cart</h1>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Your cart is empty.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">

                <table class="table table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Product Name</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Subtotal</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong>@item.ProductName</strong>
                                </td>

                                <td>
                                    ₱@item.Price.ToString("N2")
                                </td>

                                <td>

                                    <form asp-action="UpdateQuantity"
                                          method="post"
                                          class="d-flex gap-2">

                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        <input type="number"
                                               name="quantity"
                                               value="@item.Quantity"
                                               min="1"
                                               class="form-control"
                                               style="width: 90px;" />

                                        <button type="submit"
                                                class="btn btn-primary btn-sm">
                                            Update
                                        </button>

                                    </form>

                                </td>

                                <td>
                                    ₱@((item.Price * item.Quantity).ToString("N2"))
                                </td>

                                <td>

                                    <form asp-action="Remove"
                                          method="post">

                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        <button type="submit"
                                                class="btn btn-danger btn-sm">
                                            Remove
                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        </div>

        <div class="text-end mt-4">

            <h3>
                Total:
                <span class="text-success">
                    ₱@(((decimal)ViewBag.Total).ToString("N2"))
                </span>
            </h3>

        </div>
    }

    <a asp-controller="Products"
       asp-action="Index"
       class="btn btn-secondary mt-3">
        Back to Products
    </a>

</div>